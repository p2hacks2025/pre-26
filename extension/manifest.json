{
  "manifest_version": 3,
  "name": "History Visualizer",
  "version": "1.0.0",
  "description": "ブラウザ履歴をネットワークグラフとして可視化",
  "permissions": [
    "history"
  ],
  "action": {
    "default_title": "History Visualizer"
